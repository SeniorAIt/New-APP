@model WorkbookManagement.Models.DashboardVm
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";

    var tz = (TimeZoneInfo)ViewBag.DisplayTimeZone;
    string tzShort =
        tz.StandardName.Contains("South Africa", StringComparison.OrdinalIgnoreCase) ? "SAST" :
        (tz.Id?.Contains("Johannesburg", StringComparison.OrdinalIgnoreCase) == true ? "SAST" : tz.DisplayName);

    DateTime FromUtc(DateTime utc) => TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), tz);
    string FmtDT(DateTime utc) => FromUtc(utc).ToString("yyyy/MM/dd HH:mm");
    string FmtTime(DateTime utc) => FromUtc(utc).ToString("HH:mm");
    string FmtSize(long b)
    {
        var units = new[] { "B", "KB", "MB", "GB", "TB" };
        double size = b; int u = 0;
        while (size >= 1024 && u < units.Length - 1) { size /= 1024; u++; }
        return $"{size:0.#} {units[u]}";
    }

    var first = new DateTime(Model.Year, Model.Month, 1);
    var prev = first.AddMonths(-1);
    var next = first.AddMonths(1);
    int daysInMonth = DateTime.DaysInMonth(Model.Year, Model.Month);
    int startDay = (int)first.DayOfWeek; // Sunday=0

    var grouped = Model.Events
        .GroupBy(e => FromUtc(e.StartUtc).Date)
        .ToDictionary(g => g.Key, g => g.ToList());

    string MonthName(int m) => new DateTime(2000, m, 1).ToString("MMMM");

    var todayLocal = FromUtc(DateTime.UtcNow).Date;
    bool isSuperAdmin = (User?.IsInRole("SuperAdmin") ?? false);  // <- null-safe
}

@section Styles {
    <style>
        .dash-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .75rem;
            margin-bottom: 1rem;
        }

        .dash-title {
            display: flex;
            align-items: center;
            gap: .6rem;
        }

        .tz-badge {
            font-size: .75rem;
            padding: .15rem .5rem;
            border-radius: 999px;
            background: #eef2ff;
            color: #3730a3;
            border: 1px solid #c7d2fe;
        }

        .dashboard-card {
            border: 1px solid #e5e7eb;
            border-radius: 14px;
            box-shadow: 0 2px 10px rgba(0,0,0,.03);
            transition: box-shadow .18s ease, transform .18s ease;
        }

            .dashboard-card:hover {
                box-shadow: 0 8px 28px rgba(0,0,0,.06);
                transform: translateY(-1px);
            }

        .card-header-clean {
            background: #fff;
            border-bottom: 1px solid #edeef0;
        }

        .ann-panel {
            max-height: 440px;
            overflow: auto;
        }

        .ann-item + .ann-item {
            border-top: 1px dashed #ececec;
        }

        .ann-title {
            font-weight: 600;
        }

        .ann-meta {
            font-size: .85rem;
            color: #6c757d;
        }

        .stat-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: .75rem;
        }

        .stat-tile {
            border: 1px solid #eef0f2;
            border-radius: 12px;
            padding: .75rem;
            background: #fff;
        }

        .stat-label {
            font-size: .85rem;
            color: #6b7280;
        }

        .stat-value {
            font-weight: 700;
            font-size: 1.15rem;
        }

        .calendar-table {
            table-layout: fixed;
        }

        .cal-cell {
            min-width: 130px;
            height: 120px;
            vertical-align: top;
            padding: .5rem;
        }

        .cal-empty {
            background: #fafafa;
        }

        .cal-daynum {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            border-radius: 6px;
            font-weight: 600;
        }

        .cal-today .cal-daynum {
            background: #e0f2fe;
            color: #075985;
        }

        .badge-event {
            display: block;
            width: 100%;
            text-align: left;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

            .badge-event:hover {
                filter: brightness(0.95);
                text-decoration: none;
            }

        .cal-nav .btn {
            min-width: 72px;
        }

        .icon {
            display: inline-block;
            width: 18px;
            height: 18px;
            vertical-align: -3px;
            fill: currentColor;
        }

        .doc-icon {
            width: 16px;
            height: 16px;
            vertical-align: -2px;
        }

        .table-sm td {
            vertical-align: middle;
        }
    </style>
}

<div class="dash-header">
    <div class="dash-title">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M4 4h16v16H4z" fill="none" />
            <path d="M7 3v2H5a2 2 0 0 0-2 2v2h18V7a2 2 0 0 0-2-2h-2V3h-2v2H9V3H7zm14 8H3v7a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7z" />
        </svg>
        <h1 class="h4 mb-0">Dashboard</h1>
        <span class="tz-badge">Times shown in @tzShort</span>
    </div>

    @if (isSuperAdmin)
    {
        <div class="d-flex gap-2">
            <a class="btn btn-sm btn-outline-primary" asp-area="Admin" asp-controller="Announcements" asp-action="Create">
                <svg class="icon" viewBox="0 0 24 24"><path d="M11 11V5h2v6h6v2h-6v6h-2v-6H5v-2h6z" /></svg>
                <span class="ms-1">Announcement</span>
            </a>
            <a class="btn btn-sm btn-outline-success" asp-area="Admin" asp-controller="Calendar" asp-action="Create">
                <svg class="icon" viewBox="0 0 24 24"><path d="M19 4h-1V2h-2v2H8V2H6v2H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 15H5V10h14v9z" /></svg>
                <span class="ms-1">Event</span>
            </a>
        </div>
    }
</div>

<div class="row g-3">
    <!-- LEFT COLUMN -->
    <div class="col-12 col-xl-5">

        <!-- Announcements -->
        <div class="card dashboard-card mb-3">
            <div class="card-header card-header-clean d-flex justify-content-between align-items-center">
                <div class="fw-semibold d-flex align-items-center gap-2">
                    <svg class="icon" viewBox="0 0 24 24"><path d="M2 12l18-9-4 14-6-4-8-1z" /><path d="M13 14l6 6" /></svg>
                    Announcements
                </div>
                <div class="small text-muted">@Model.Announcements.Count item(s)</div>
            </div>
            <div class="card-body ann-panel">
                @if (!Model.Announcements.Any())
                {
                    <div class="text-muted">No announcements.</div>
                }
                else
                {
                    foreach (var a in Model.Announcements)
                    {
                        <div class="ann-item pb-3 mb-3">
                            <div class="ann-title">@a.Title</div>
                            <div class="ann-meta">@FmtDT(a.CreatedAtUtc)</div>
                            <div class="mt-1">@a.Body</div>

                            @* NEW: attachment buttons for users (non-Admin endpoints) *@
                            @if (a.HasAttachment)
                            {
                                <div class="mt-2 d-flex align-items-center gap-2">
                                    <a asp-controller="Announcements" asp-action="Open" asp-route-id="@a.Id"
                                       class="btn btn-sm btn-outline-primary">Open</a>
                                    <a asp-controller="Announcements" asp-action="Download" asp-route-id="@a.Id"
                                       class="btn btn-sm btn-outline-secondary">Download</a>
                                    <span class="small text-muted ms-1">@a.AttachmentFileName</span>
                                </div>
                            }
                        </div>
                    }
                }
            </div>
        </div>

        @if (!isSuperAdmin)
        {
            <!-- Company users see Submission Status -->
            <div class="card dashboard-card mb-3">
                <div class="card-header card-header-clean d-flex justify-content-between align-items-center">
                    <div class="fw-semibold d-flex align-items-center gap-2">
                        <svg class="icon" viewBox="0 0 24 24"><path d="M3 3h18v2H3zm0 6h18v2H3zm0 6h18v2H3z" /></svg>
                        Submission Status
                    </div>
                    <a class="small" asp-controller="Submissions" asp-action="Index">Open Submissions</a>
                </div>
                <div class="card-body">
                    @{
                        var s = Model.SubmissionSummary;
                        var pct = (int)Math.Round(s.DecidedPercent);
                    }
                    @if (s.Total == 0)
                    {
                        <div class="text-muted">No bundles yet.</div>
                    }
                    else
                    {
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span>Overall completion</span>
                                <span>@s.Decided of @s.Total decided (@pct%)</span>
                            </div>
                            <div class="progress" role="progressbar"
                                 aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100"
                                 title="@pct% decided">
                                <div class="progress-bar bg-success" style="width:@pct%"></div>
                            </div>
                        </div>
                        <div class="stat-grid">
                            <div class="stat-tile"><div class="stat-label">Draft</div><div class="stat-value">@s.Draft</div></div>
                            <div class="stat-tile"><div class="stat-label">In Progress</div><div class="stat-value">@s.InProgress</div></div>
                            <div class="stat-tile"><div class="stat-label">Completed</div><div class="stat-value">@s.Completed</div></div>
                            <div class="stat-tile"><div class="stat-label">Submitted</div><div class="stat-value">@s.Submitted</div></div>
                            <div class="stat-tile"><div class="stat-label">Approved</div><div class="stat-value">@s.Approved</div></div>
                            <div class="stat-tile"><div class="stat-label">Rejected</div><div class="stat-value">@s.Rejected</div></div>
                        </div>
                        <div class="mt-3 small text-muted">
                            Remaining (not yet decided): <strong>@s.Undecided</strong>
                        </div>
                    }
                </div>
            </div>

            <!-- Recent Documents (company users) -->
            <div class="card dashboard-card">
                <div class="card-header card-header-clean d-flex justify-content-between align-items-center">
                    <div class="fw-semibold d-flex align-items-center gap-2">
                        <svg class="icon" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zM6 20V4h7v5h5v11H6z" /></svg>
                        Recent Documents
                    </div>
                    <a class="small" asp-controller="Documents" asp-action="Index">Open Documents</a>
                </div>
                <div class="card-body p-0">
                    @if (!Model.RecentDocuments.Any())
                    {
                        <div class="p-3 text-muted">No recent uploads.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width:40%">File</th>
                                        <th>Type</th>
                                        <th class="text-end">Size</th>
                                        <th>Uploaded</th>
                                        <th class="text-end" style="width:120px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in Model.RecentDocuments)
                                    {
                                        <tr>
                                            <td>
                                                <svg class="doc-icon" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zM6 20V4h7v5h5v11H6z" /></svg>
                                                <span class="ms-1">@d.FileName</span>
                                            </td>
                                            <td class="small text-muted">@d.ContentType</td>
                                            <td class="text-end">@FmtSize(d.SizeBytes)</td>
                                            <td class="small">
                                                <div>@FmtDT(d.UploadedAtUtc)</div>
                                                @if (!string.IsNullOrWhiteSpace(d.UploadedBy))
                                                {
                                                    <div class="text-muted">@d.UploadedBy</div>
                                                }
                                            </td>
                                            <td class="text-end">
                                                <a class="btn btn-sm btn-outline-secondary"
                                                   asp-controller="Documents" asp-action="View" asp-route-id="@d.Id" target="_blank" rel="noopener">View</a>
                                                <a class="btn btn-sm btn-primary"
                                                   asp-controller="Documents" asp-action="Download" asp-route-id="@d.Id">Download</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- SUPERADMIN: Review queue -->
            <div class="card dashboard-card mb-3">
                <div class="card-header card-header-clean d-flex justify-content-between align-items-center">
                    <div class="fw-semibold d-flex align-items-center gap-2">
                        <svg class="icon" viewBox="0 0 24 24"><path d="M3 3h18v2H3zm0 6h18v2H3zm0 6h18v2H3z" /></svg>
                        Review queue
                    </div>
                    <a class="small" asp-area="Admin" asp-controller="Reviews" asp-action="Index">Open Review Queue</a> <!-- updated -->
                </div>
                <div class="card-body p-0">
                    @if (!Model.PendingReviews.Any())
                    {
                        <div class="p-3 text-muted">No bundles waiting for review.</div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-sm mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th>Company</th>
                                        <th>Owner</th>
                                        <th class="text-end" style="width:120px;">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var s in Model.PendingReviews)
                                    {
                                        <tr>
                                            <td>@s.CompanyName</td>
                                            <td class="small text-muted">@s.OwnerEmail</td>
                                            <td class="text-end">
                                                <a class="btn btn-sm btn-primary"
                                                   asp-area="Admin" asp-controller="Submissions" asp-action="Details" asp-route-id="@s.Id">Review</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <!-- SUPERADMIN: Recent decisions -->
            <div class="card dashboard-card mb-3">
                <div class="card-header card-header-clean d-flex justify-content-between align-items-center">
                    <div class="fw-semibold d-flex align-items-center gap-2">
                        <svg class="icon" viewBox="0 0 24 24"><path d="M4 4h16v16H4z" fill="none" /><path d="M5 12h14v2H5zM5 16h10v2H5zM5 8h14v2H5z" /></svg>
                        Recent decisions
                    </div>
                    <a class="small" asp-area="Admin" asp-controller="Reviews" asp-action="Index">All decisions</a> <!-- updated -->
                </div>
                <div class="card-body">
                    @if (!Model.RecentDecisions.Any())
                    {
                        <div class="text-muted">No recent approvals/rejections.</div>
                    }
                    else
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var d in Model.RecentDecisions)
                            {
                                <li class="mb-2">
                                    <strong>@d.CompanyName</strong>
                                    <span class="text-muted"> — @d.OwnerEmail</span>
                                    <span class="badge @(d.Status == WorkbookManagement.Models.SubmissionBundleStatus.Approved ? "bg-success" : "bg-danger") ms-2">
                                        @d.Status
                                    </span>
                                    @if (d.DecidedAtUtc.HasValue)
                                    {
                                        <span class="text-muted ms-2">@FmtDT(d.DecidedAtUtc.Value)</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(d.DecidedByEmail))
                                    {
                                        <span class="text-muted ms-2">by @d.DecidedByEmail</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(d.DecisionNote))
                                    {
                                        <div class="small text-muted">“@d.DecisionNote”</div>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        }

    </div>

    <!-- RIGHT COLUMN: Calendar -->
    <div class="col-12 col-xl-7">
        <div class="card dashboard-card h-100">
            <div class="card-header card-header-clean d-flex justify-content-between align-items-center">
                <div class="fw-semibold d-flex align-items-center gap-2">
                    <svg class="icon" viewBox="0 0 24 24"><path d="M19 4h-1V2h-2v2H8V2H6v2H5a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2zm0 15H5V10h14v9z" /></svg>
                    Calendar — @MonthName(Model.Month) @Model.Year
                </div>
                <div class="cal-nav d-flex gap-2">
                    <a class="btn btn-sm btn-outline-secondary"
                       asp-action="Index" asp-route-year="@prev.Year" asp-route-month="@prev.Month">← Prev</a>
                    <a class="btn btn-sm btn-outline-secondary"
                       asp-action="Index" asp-route-year="@next.Year" asp-route-month="@next.Month">Next →</a>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered calendar-table align-middle text-center small mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Sun</th>
                                <th>Mon</th>
                                <th>Tue</th>
                                <th>Wed</th>
                                <th>Thu</th>
                                <th>Fri</th>
                                <th>Sat</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                int day = 1;
                                for (int r = 0; r < 6 && day <= daysInMonth; r++)
                                {
                                    <tr>
                                        @for (int c = 0; c < 7; c++)
                                        {
                                            if ((r == 0 && c < startDay) || day > daysInMonth)
                                            {
                                                <td class="cal-cell cal-empty"></td>
                                            }
                                            else
                                            {
                                                var localDate = new DateTime(Model.Year, Model.Month, day);
                                                var has = grouped.ContainsKey(localDate.Date);
                                                var isToday = localDate.Date == todayLocal;
                                                <td class="cal-cell text-start @(isToday ? "cal-today" : "")">
                                                    <div class="cal-daynum mb-1">@day</div>
                                                    @if (has)
                                                    {
                                                        foreach (var ev in grouped[localDate.Date].Take(3))
                                                        {
                                                            <span class="badge bg-secondary badge-event mb-1" title="@ev.Title">
                                                                @if (!ev.AllDay)
                                                                {
                                                                    <span>@FmtTime(ev.StartUtc)</span>
                                                                    <span> · </span>
                                                                }
                                                                <span>@ev.Title</span>
                                                            </span>
                                                        }
                                                        if (grouped[localDate.Date].Count > 3)
                                                        {
                                                            <div class="small text-muted">+@(grouped[localDate.Date].Count - 3) more…</div>
                                                        }
                                                    }
                                                </td>
                                                day++;
                                            }
                                        }
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.Events.Any())
                {
                    <div class="mt-3">
                        <div class="fw-semibold mb-1">This month</div>
                        <ul class="list-unstyled mb-0">
                            @foreach (var e in Model.Events)
                            {
                                <li class="mb-1">
                                    <span class="text-muted">@FmtDT(e.StartUtc)</span> — <strong>@e.Title</strong>
                                    @if (!string.IsNullOrWhiteSpace(e.Description))
                                    {
                                        <span class="text-muted"> · @e.Description</span>
                                    }
                                </li>
                            }
                        </ul>
                    </div>
                }
                else
                {
                    <div class="text-muted mt-2">No events this month.</div>
                }
            </div>
        </div>
    </div>
</div>
