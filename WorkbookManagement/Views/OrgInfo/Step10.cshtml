        <td><input name="Rows[__idx__].African.F" type="number" class="form-control form-control-sm fval" /></td>
        <td><input name="Rows[__idx__].African.FD" type="number" class="form-control form-control-sm" /></td>

        <td><input name="Rows[__idx__].Coloured.M" type="number" class="form-control form-control-sm mval" /></td>
        <td><input name="Rows[__idx__].Coloured.MD" type="number" class="form-control form-control-sm" /></td>
        <td><input name="Rows[__idx__].Coloured.F" type="number" class="form-control form-control-sm fval" /></td>
        <td><input name="Rows[__idx__].Coloured.FD" type="number" class="form-control form-control-sm" /></td>

        <td><input name="Rows[__idx__].Indian.M" type="number" class="form-control form-control-sm mval" /></td>
        <td><input name="Rows[__idx__].Indian.MD" type="number" class="form-control form-control-sm" /></td>
        <td><input name="Rows[__idx__].Indian.F" type="number" class="form-control form-control-sm fval" /></td>
        <td><input name="Rows[__idx__].Indian.FD" type="number" class="form-control form-control-sm" /></td>

        <td><input name="Rows[__idx__].White.M" type="number" class="form-control form-control-sm mval" /></td>
        <td><input name="Rows[__idx__].White.MD" type="number" class="form-control form-control-sm" /></td>
        <td><input name="Rows[__idx__].White.F" type="number" class="form-control form-control-sm fval" /></td>
        <td><input name="Rows[__idx__].White.FD" type="number" class="form-control form-control-sm" /></td>

        <td><input name="Rows[__idx__].Total" type="number" class="form-control form-control-sm total" readonly /></td>

        <td><input name="Rows[__idx__].IP" type="number" class="form-control form-control-sm out ip" /></td>
        <td><input name="Rows[__idx__].IPPercent" type="number" step="0.01" class="form-control form-control-sm ipp" readonly /></td>

        <td><input name="Rows[__idx__].SC" type="number" class="form-control form-control-sm out sc" /></td>
        <td><input name="Rows[__idx__].SCPercent" type="number" step="0.01" class="form-control form-control-sm scp" readonly /></td>

        <td><input name="Rows[__idx__].PR" type="number" class="form-control form-control-sm out pr" /></td>
        <td><input name="Rows[__idx__].PRPercent" type="number" step="0.01" class="form-control form-control-sm prp" readonly /></td>

        <td><input name="Rows[__idx__].DI" type="number" class="form-control form-control-sm out di" /></td>
